{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Game Shelf",
  "version": "0.1.0",
  "identifier": "io.github.omerm21.gameshelfwidget",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Game Shelf",
        "width": 1100,
        "height": 380,
        "minWidth": 320,
        "minHeight": 200,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnBottom": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "publisher": "Game Shelf Widget",
    "copyright": "Copyright (c) 2026 Game Shelf Widget contributors. MIT License.",
    "category": "Game",
    "shortDescription": "A desktop widget that shows your games as book spines on a shelf.",
    "homepage": "https://github.com/OmerM21/game-shelf-widget",
    "license": "MIT"
  }
}
